BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Always
ColumnLimit: 90

BreakBeforeBraces: Custom
BraceWrapping:
    AfterClass: true
    AfterControlStatement: true
    AfterEnum: false
    AfterFunction: true
    AfterNamespace: false
    AfterObjCDeclaration: false
    AfterStruct: true
    AfterUnion: false
    BeforeCatch: false
    BeforeElse: false
    IndentBraces: false
# Disable bin-packing for parameters and arguments
BinPackParameters: false
BinPackArguments: false

# Constructor init lists: either all on one line, or one member per line.
# Avoids packing short inits mid-line then mangling a long call (e.g. app(...)).
ConstructorInitializerAllOnOneLineOrOnePerLine: true
PackConstructorInitializers: NextLine
ConstructorInitializerIndentWidth: 4
AllowAllConstructorInitializersOnNextLine: false

# Break after the open paren of a call rather than hanging args mid-line
# after a long initializer.
PenaltyBreakBeforeFirstCallParameter: 1
PenaltyExcessCharacter: 50

# Let short functions stay on one line if they fit
AllowShortFunctionsOnASingleLine: All
