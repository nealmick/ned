// Fallback / hand-edit copy. CMake configures resources/windows/ned.rc.in into the
// build tree with an absolute path to ned.ico — that generated file is what gets
// linked. Keep this in sync if you edit icons by hand without reconfiguring.
//
// Application icon: ID 1 is the shell's primary .exe icon.
// Path is relative to this .rc file (resources/windows/ → resources/icons/).
1 ICON "../icons/ned.ico"

// Version information
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "Ned Team"
            VALUE "FileDescription", "Ned Text Editor"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ned"
            VALUE "OriginalFilename", "ned.exe"
            VALUE "ProductName", "Ned"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
