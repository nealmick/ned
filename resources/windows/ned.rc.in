// Generated from ned.rc.in — do not edit the configured copy in the build tree.
// Application icon: resource ID 1 is what Explorer / the shell use for the .exe.
// Path is absolute so rc.exe does not depend on cwd vs .rc location.
1 ICON "@NED_ICON_PATH@"

// Version information
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "Ned Team"
            VALUE "FileDescription", "Ned Text Editor"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ned"
            VALUE "OriginalFilename", "ned.exe"
            VALUE "ProductName", "Ned"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
